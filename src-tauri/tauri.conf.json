{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "PSoftware",
    "mainBinaryName": "PSoftware",
    "version": "999.999.999",
    "identifier": "com.psoft.app",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "PSoftware",
                "create": false,
                "center": true,
                "width": 1400,
                "height": 752,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self' customprotocol: asset:",
                "connect-src": "'self' ipc: http://ipc.localhost wss:",
                "font-src": "'self' data:",
                "img-src": "'self' asset: http://asset.localhost blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "script-src": "'self'",
                "object-src": "'none'",
                "frame-src": "'self' blob:",
                "base-uri": "'self'",
                "form-action": "'self'"
            },
            "devCsp": {
                "default-src": "'self' customprotocol: asset:",
                "connect-src": "'self' ipc: http://ipc.localhost ws:",
                "font-src": "'self' data:",
                "img-src": "'self' asset: http://asset.localhost blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "script-src": "'self'",
                "object-src": "'none'",
                "frame-src": "'self' blob:",
                "base-uri": "'self'",
                "form-action": "'self'"
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "publisher": "PSoftware",
        "targets": "all",
        "resources": ["resources/manifest", "resources/manifest.sig"],
        "icon": [
            "icons/128x128.png",
            "icons/32x32.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "languages": ["French"],
                "displayLanguageSelector": false
            }
        }
    },
    "plugins": {
        "updater": {
            "dangerousInsecureTransportProtocol": true,
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQTkxMThEMkUzMkIKUldRcjQ5SVlrZG9MQU1VMHRrNDdleUhmOEQxMktCek9XRmJqWkVWVHNuajlqS01URkVhcWI2QmoK",
            "endpoints": []
        }
    }
}
