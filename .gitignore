# Keep required assets and documentation, including in the parent repository.
!/docs/
!/docs/**
!/static/
!/static/**
!/src-tauri/icons/
!/src-tauri/icons/**
!/src-tauri/resources/manifest.sig

# Dependencies, caches and frontend build output
node_modules/
/.bun-cache/
/.svelte-kit/
/build/
/dist/
/package/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust build output and generated schemas are ignored by src-tauri/.gitignore.

# Local configuration, signing keys and logs
.env
.env.*
!.env.example
!.env.*.example
/src-tauri/psoft.key
/src-tauri/psoft.key.pub
*.log

# Personal notes
/TODO.md
/TOOD.md
/AUDIT.md
/SECURITY-WARNING.md
/FUTURE-FEATURES.md

# Editor and operating-system files
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
